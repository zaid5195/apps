{
  "manifest_version": 3,
  "name": "منزّل فصول المانهوا",
  "short_name": "منزّل المانهوا",
  "version": "2.0.0",
  "description": "نزّل فصول المانهوا والمانجا من صفحة القارئ مباشرة: ZIP أو PDF أو صور منفصلة.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "منزّل فصول المانهوا",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "sidePanel",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}